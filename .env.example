# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Database (M0) ---------------------------------------------------------
# Matches docker-compose.yml. Host port is 5433 to avoid clashing with a
# local Postgres already on 5432.
DATABASE_URL=postgres://pulse:pulse@localhost:5433/pulse

# --- API (M0) --------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Sources (M0/M1) -------------------------------------------------------
# Every source is a good web citizen: identify yourself.
USER_AGENT=pulse/0.1 (personal project; contact: you@example.com)

# Reddit OAuth. LEAVE BLANK to use the public .rss adapter, which needs no
# credentials. Fill these in only once Reddit approves your app at
# reddit.com/prefs/apps, and the registry switches to the OAuth adapter
# automatically -- no code change needed.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Claude sentiment scoring (M2) -----------------------------------------
# COSTS MONEY. Nothing in M0 or M1 calls this.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Auth (M4) -------------------------------------------------------------
JWT_SECRET=
DEMO_USER_EMAIL=demo@pulse.local
DEMO_USER_PASSWORD=
ADMIN_USER_EMAIL=
ADMIN_USER_PASSWORD=

# --- Twilio SMS alerting (M7) ----------------------------------------------
# COSTS MONEY. Nothing before M7 touches this.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
