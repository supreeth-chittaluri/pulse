# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Database (M0) ---------------------------------------------------------
# Matches docker-compose.yml. Host port is 5433 to avoid clashing with a
# local Postgres already on 5432.
DATABASE_URL=postgres://pulse:pulse@localhost:5433/pulse

# --- API (M0) --------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Sources (M0/M1) -------------------------------------------------------
# Every source is a good web citizen: identify yourself.
USER_AGENT=pulse/0.1 (personal project; contact: you@example.com)

# Reddit OAuth. LEAVE BLANK to use the public .rss adapter, which needs no
# credentials. Fill these in only once Reddit approves your app at
# reddit.com/prefs/apps, and the registry switches to the OAuth adapter
# automatically -- no code change needed.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Gemini sentiment scoring (M2) -----------------------------------------
# Free tier, no credit card. Key: https://aistudio.google.com/apikey
#
# Google no longer publishes per-model free-tier quotas in its docs -- your
# project's actual limits are at https://aistudio.google.com/rate-limit.
# Check them before raising GEMINI_DAILY_REQUEST_BUDGET below.
#
# WARNING: enabling billing on the Google Cloud project REMOVES the free tier
# for that project entirely -- every call becomes billable from the first
# token. Keep this key on a project with billing switched off.
#
# NOTE: on the free tier, Google's terms permit using submitted prompts to
# improve their models (the paid tier and Vertex AI do not). Everything pulse
# sends is already-public Reddit/HN/news text, but the tradeoff is real.
# Measured on this project's own dashboard (2026-09-04). Google does not
# publish these; check https://aistudio.google.com/rate-limit for yours.
#
#   gemini-3.5-flash        5 RPM  / 250K TPM /  20 RPD
#   gemini-3.5-flash-lite  15 RPM  / 250K TPM / 500 RPD
#
# Flash Lite it is: 20 requests/day cannot even clear a 22-request backlog,
# and sentiment classification on short posts is well within Lite's range.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Client-side throttle: 4000ms = 15 requests/minute, matching Flash Lite's
# real RPM ceiling above. Lower this only if you switch to a faster tier.
GEMINI_MIN_INTERVAL_MS=4000

# Hard local ceiling on requests per Pacific-midnight day. Set below the real
# 500 RPD so a runaway loop leaves headroom rather than exhausting the quota.
GEMINI_DAILY_REQUEST_BUDGET=400

# Posts per request. Larger batches mean fewer requests against the daily
# quota, at some risk to per-post attention. 10-20 is the sane range.
SCORING_BATCH_SIZE=15

# --- Auth (M4) -------------------------------------------------------------
# Required in production, minimum 32 chars. Left blank in development a random
# per-process key is used instead -- tokens then stop working across restarts,
# which is mildly annoying and much safer than a default that reaches
# production by accident. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL_HOURS=12
DEMO_USER_EMAIL=demo@pulse.local
DEMO_USER_PASSWORD=
# The admin password has NO default. Seeding refuses to create an admin
# without one, and requires at least 12 characters.
ADMIN_USER_EMAIL=
ADMIN_USER_PASSWORD=

# Comma-separated origins allowed to call the API from a browser (M6/M8).
# Empty disables CORS entirely, which is correct for same-origin local dev.
CORS_ORIGINS=

# Requests per minute per IP. The 61st request in a minute is throttled.
RATE_LIMIT_PER_MINUTE=60
ADMIN_RATE_LIMIT_PER_MINUTE=10
CACHE_TTL_SECONDS=20

# Number of proxy hops to trust for req.ip. Render/Fly/Vercel need 1; without
# it every request looks like it came from the proxy and one client's traffic
# throttles everyone. Keep 0 for local development.
TRUST_PROXY=0

# --- Twilio SMS alerting (M7) ----------------------------------------------
# THE ONLY PART OF PULSE THAT COSTS MONEY. Roughly $1.15/month for a number
# plus ~$0.008 per message; trial credit covers the demo.
#
# Alerting stays OFF until you flip this to true, even with credentials set.
ALERTS_ENABLED=false

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# On a Twilio trial account this must be a verified number.
TWILIO_TO_NUMBER=

# Which spikes are worth a phone buzzing. "volume+sentiment" (default) means a
# surge that also moved the mood; "any" includes volume-only surges, which are
# usually just a scheduled news cycle and will get the alerts muted.
ALERT_KIND=volume+sentiment

# Three independent brakes on spend, on top of the watchlist opt-in.
ALERT_COOLDOWN_HOURS=6
ALERT_DAILY_BUDGET=10
ALERT_MAX_SPIKE_AGE_HOURS=6
